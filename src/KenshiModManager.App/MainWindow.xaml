<Window x:Class="KenshiModManager.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Kenshi Mod Manager — Profile Studio" Style="{StaticResource {x:Type Window}}" Width="1440" Height="900" MinWidth="1024" MinHeight="700" WindowStartupLocation="CenterScreen" PreviewKeyDown="WindowKeyDown">
 <Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <Border Grid.RowSpan="2" Background="{StaticResource Sidebar}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0"><Grid Margin="16,24,16,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="KENSHI" FontSize="22" FontWeight="Bold"/><TextBlock Text="PROFILE STUDIO" Style="{StaticResource Muted}" Margin="0,4,0,28"/><TextBlock Text="YOUR PROFILES" Style="{StaticResource Muted}" FontWeight="SemiBold"/></StackPanel>
   <Button Grid.Row="1" Content="+  New profile" Click="NewProfileClick" Margin="0,12,0,12" HorizontalContentAlignment="Left" AutomationProperties.Name="Create profile"/>
   <ListBox x:Name="ProfileList" Grid.Row="2" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile,Mode=OneWay}" SelectionChanged="ProfileSelectionChanged" AutomationProperties.Name="Profiles"><ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="Load order profile" Style="{StaticResource Muted}" Margin="0,4,0,0"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
   <StackPanel Grid.Row="3"><WrapPanel Margin="0,12,0,8"><Button Content="Rename" Click="RenameClick"/><Button Content="Duplicate" Click="DuplicateClick"/></WrapPanel><Button Content="Delete profile" Click="DeleteClick" Foreground="{StaticResource Error}" Margin="0,0,0,16"/><Border Height="1" Background="{StaticResource Line}"/><Expander Header="Game setup &amp; backups" Margin="0,16,0,12"><StackPanel Margin="0,12,0,0"><Button Content="Game folders" Click="SettingsClick" Margin="0,0,0,8"/><Button Content="Rescan library" Click="ScanClick" Margin="0,0,0,8"/><Button x:Name="ReloadButton" Content="Reload game snapshot" Click="ReloadClick" Margin="0,0,0,8"/><Button x:Name="RestoreButton" Content="Restore backup" Click="RestoreClick" ToolTipService.ShowOnDisabled="True"/><TextBlock x:Name="RestoreReason" TextWrapping="Wrap" Style="{StaticResource Muted}" Margin="0,8,0,0"/></StackPanel></Expander><TextBlock Text="Steam downloads the mods. You choose what Kenshi loads." TextWrapping="Wrap" Style="{StaticResource Muted}" LineHeight="21"/></StackPanel>
  </Grid></Border>
  <Grid Grid.Column="1" Margin="24,24,24,16"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <StackPanel><TextBlock Text="EDITING PROFILE · NOT AUTOMATICALLY APPLIED" Style="{StaticResource Muted}"/><TextBlock x:Name="ProfileHeading" Text="Loading profile…" FontSize="28" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" Margin="0,4,0,0"/><TextBlock x:Name="GameMatchLabel" Text="Current game order unknown" Foreground="{StaticResource Accent}" Margin="0,6,0,0"/></StackPanel>
   <Border Grid.Row="1" Background="{StaticResource Surface}" BorderBrush="{StaticResource Line}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,16,0,12"><TextBlock x:Name="Notice" Text="Loading manager state…" TextWrapping="Wrap"/></Border>
   <WrapPanel Grid.Row="2" Margin="0,0,0,12"><Button Content="Add installed mods" Click="AddInstalledClick" Style="{StaticResource Primary}"/><Button Content="Paste load order" Click="PasteClick"/><Button Content="Import file" Click="ImportClick"/><Button Content="Export" Click="ExportClick"/><Button Content="Undo" Click="UndoClick" IsEnabled="{Binding CanUndo}" ToolTip="Ctrl+Z · profile edits only"/><Button Content="Redo" Click="RedoClick" IsEnabled="{Binding CanRedo}" ToolTip="Ctrl+Y"/><Button Content="Issues" Click="IssuesClick"/><Button Content="Notes &amp; source" Click="MetadataClick"/></WrapPanel>
   <Grid Grid.Row="3" Margin="0,0,0,12">
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="40"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/><ColumnDefinition Width="120"/></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <TextBlock Text="Find a mod in this profile · Ctrl+F" Style="{StaticResource Muted}" Margin="0,0,0,6"/>
    <TextBlock Grid.Column="2" Text="Source" Style="{StaticResource Muted}" Margin="4,0,0,6"/>
    <TextBlock Grid.Column="3" Text="Enabled" Style="{StaticResource Muted}" Margin="4,0,0,6"/>
    <TextBlock Grid.Column="4" Text="Status" Style="{StaticResource Muted}" Margin="4,0,0,6"/>
    <Grid Grid.Row="1">
     <TextBox x:Name="SearchBox" AutomationProperties.Name="Search titles, filenames and tags" ToolTip="Search title, exact filename or tags · Ctrl+F" TextChanged="FilterChanged"/>
     <TextBlock Text="Search mods, filenames or tags…" Margin="10,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" IsHitTestVisible="False">
      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Secondary}"/><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Text,ElementName=SearchBox}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></TextBlock.Style>
     </TextBlock>
    </Grid>
    <Button Grid.Row="1" Grid.Column="1" Content="×" Padding="0" Click="ClearClick" AutomationProperties.Name="Clear filters"/>
    <ComboBox x:Name="SourceFilter" Grid.Row="1" Grid.Column="2" SelectedIndex="0" SelectionChanged="FilterSelectionChanged" Margin="4,0" AutomationProperties.Name="Mod source filter"><ComboBoxItem Content="All"/><ComboBoxItem Content="Local"/><ComboBoxItem Content="Workshop"/></ComboBox>
    <ComboBox x:Name="EnabledFilter" Grid.Row="1" Grid.Column="3" SelectedIndex="0" SelectionChanged="FilterSelectionChanged" Margin="4,0" AutomationProperties.Name="Enabled filter"><ComboBoxItem Content="All"/><ComboBoxItem Content="Enabled"/><ComboBoxItem Content="Disabled"/></ComboBox>
    <ComboBox x:Name="StatusFilter" Grid.Row="1" Grid.Column="4" SelectedIndex="0" SelectionChanged="FilterSelectionChanged" Margin="4,0,0,0" AutomationProperties.Name="Installation status filter"><ComboBoxItem Content="All"/><ComboBoxItem Content="Installed"/><ComboBoxItem Content="Missing"/><ComboBoxItem Content="Ambiguous"/></ComboBox>
   </Grid>
   <Grid Grid.Row="4"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
    <DockPanel Margin="0,0,0,10"><TextBlock x:Name="ProfileCountLabel" DockPanel.Dock="Right" Style="{StaticResource Muted}"/><TextBlock Text="LOAD ORDER" FontWeight="SemiBold" Foreground="{StaticResource Secondary}"/></DockPanel>
    <Grid Grid.Row="1"><DataGrid x:Name="ModGrid" AutoGenerateColumns="False" IsReadOnly="True" CanUserAddRows="False" CanUserDeleteRows="False" CanUserSortColumns="False" CanUserReorderColumns="False" SelectionMode="Extended" SelectionUnit="FullRow" SelectionChanged="ModSelectionChanged" PreviewMouseLeftButtonDown="DragStart" PreviewMouseMove="DragMove" AllowDrop="True" DragOver="GridDragOver" Drop="GridDrop" AutomationProperties.Name="Ordered mods. Space toggles selection; Alt arrows move selection."><DataGrid.Columns>
     <DataGridTemplateColumn Header="ON" Width="48"><DataGridTemplateColumn.CellTemplate><DataTemplate><CheckBox IsChecked="{Binding Enabled,Mode=OneWay}" Click="ToggleClick" AutomationProperties.Name="{Binding FileName,StringFormat=Enable {0}}"/></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="#" Binding="{Binding Position}" Width="52"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="VerticalAlignment" Value="Center"/><Setter Property="FontFamily" Value="Consolas"/><Setter Property="Foreground" Value="{StaticResource Secondary}"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     <DataGridTemplateColumn Header="MOD / EXACT FILENAME" Width="*"><DataGridTemplateColumn.CellTemplate><DataTemplate><StackPanel VerticalAlignment="Center" ToolTip="{Binding FileName}"><TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding FileName}" TextTrimming="CharacterEllipsis" Style="{StaticResource Muted}" Margin="0,2,0,0"/></StackPanel></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
     <DataGridTextColumn Header="SOURCE" Binding="{Binding Source}" Width="100"><DataGridTextColumn.ElementStyle><Style TargetType="TextBlock" BasedOn="{StaticResource Muted}"><Setter Property="VerticalAlignment" Value="Center"/></Style></DataGridTextColumn.ElementStyle></DataGridTextColumn>
     <DataGridTemplateColumn Header="INSTALLATION" Width="110"><DataGridTemplateColumn.CellTemplate><DataTemplate><TextBlock Text="{Binding Status}" VerticalAlignment="Center" FontSize="14"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource Accent}"/><Style.Triggers><DataTrigger Binding="{Binding Status}" Value="Missing"><Setter Property="Foreground" Value="{StaticResource Warning}"/></DataTrigger><DataTrigger Binding="{Binding Status}" Value="Ambiguous"><Setter Property="Foreground" Value="{StaticResource Error}"/></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock></DataTemplate></DataGridTemplateColumn.CellTemplate></DataGridTemplateColumn>
    </DataGrid.Columns></DataGrid><Border x:Name="EmptyPanel" Visibility="Collapsed" Background="{StaticResource Surface}"><StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Margin="24" MaxWidth="440"><TextBlock x:Name="EmptyTitle" Text="No matching mods" FontSize="20" FontWeight="SemiBold"/><TextBlock x:Name="EmptyDescription" Text="Clear filters to see this profile." TextWrapping="Wrap" Foreground="{StaticResource Secondary}" Margin="0,8,0,16"/><Button Content="Add installed mods" Click="AddInstalledClick" HorizontalAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource Primary}"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Button.Style></Button><Button Content="Clear filters" Click="ClearClick" HorizontalAlignment="Left"><Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Style.Triggers><DataTrigger Binding="{Binding Rows.Count}" Value="0"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers></Style></Button.Style></Button></StackPanel></Border></Grid>

   </Grid>
   <WrapPanel x:Name="SelectionBar" Visibility="Collapsed" Grid.Row="5" Margin="0,12,0,0"><TextBlock x:Name="SelectionLabel" Foreground="{StaticResource Secondary}" VerticalAlignment="Center" Margin="0,0,12,0" Text="0 selected"/><Button Content="Enable" Click="EnableClick"/><Button Content="Disable" Click="DisableClick"/><Button Content="↑ Up" Click="UpClick" ToolTip="Alt+Up"/><Button Content="↓ Down" Click="DownClick" ToolTip="Alt+Down"/><Button Content="Top" Click="TopClick"/><Button Content="Bottom" Click="BottomClick"/><Button Content="Move to…" Click="PositionClick"/><Button Content="Mod details" Click="DetailsClick"/><Button Content="Remove from profile" Click="RemoveClick" Foreground="{StaticResource Error}"/></WrapPanel>
  </Grid>
  <Border Grid.Row="1" Grid.Column="1" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="24,12" Background="{StaticResource Sidebar}"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel Margin="0,0,12,0"><TextBlock Text="{Binding Summary}" Style="{StaticResource Muted}"/><TextBlock x:Name="AppliedLabel" Text="No verified Apply recorded" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/><TextBlock x:Name="SaveLabel" Text="Manager state only · game untouched" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"/></StackPanel><Button x:Name="ReviewButton" Grid.Column="1" Content="Review and use…" Click="ApplyClick" Style="{StaticResource Primary}" VerticalAlignment="Center" AutomationProperties.Name="Review selected profile before a separate confirmed game write"/></Grid></Border>
 </Grid>
</Window>